# ============================================
# DEPLOYMENT ENVIRONMENT VARIABLES
# ============================================
# ⚠️  WARNING: NEVER COMMIT THIS FILE WITH REAL VALUES
# Copy this to .env.deployment and fill in your values
# ============================================

# ============================================
# NETWORK CONFIGURATION
# ============================================

# RPC URL for deployment target
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Alternative networks (uncomment as needed)
# MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc
# LOCAL_RPC_URL=http://localhost:8545

# Deployer's private key (without 0x prefix)
# ⚠️  KEEP THIS SECURE - NEVER COMMIT TO GIT
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Etherscan API key for contract verification (optional)
# ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================
# EXISTING CONTRACTS
# ============================================

# Existing ERC20 token to wrap
EXISTING_ERC20=0xb0Fe621B4Bd7fe4975f7c58E3D6ADaEb2a2A35CD

# Previous eERC contracts (for reference)
# PREVIOUS_EERC_STANDALONE=0x5E9c6F952fB9615583182e70eDDC4e6E4E0aC0e0
# PREVIOUS_EERC_CONVERTER=0x372dAB27c8d223Af11C858ea00037Dc03053B22E

# ============================================
# AUDITOR CONFIGURATION
# ============================================

# Generate these using: npx tsx scripts/generateAuditorKeys.ts
# Copy the output values here

# Auditor's public key (will be stored on-chain)
AUDITOR_PUBLIC_KEY_X=
AUDITOR_PUBLIC_KEY_Y=

# Auditor's private key (for decryption only - KEEP EXTREMELY SECURE)
# ⚠️  This should be stored separately in a secure location
# ⚠️  Only needed for auditor decryption scripts
AUDITOR_PRIVATE_KEY=

# ============================================
# DEPLOYMENT TRACKING
# ============================================
# These are auto-filled after deployment - leave empty initially

# Timestamp of deployment
DEPLOYMENT_TIMESTAMP=

# Newly deployed contract address
NEW_EERC_ADDRESS=

# Transaction hash of deployment
DEPLOYMENT_TX_HASH=

# ============================================
# AUDITOR DECRYPTION SCRIPT CONFIG
# ============================================

# RPC URL for reading contract data
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Deployed eERC contract address (for auditor scripts)
EERC_ADDRESS=

# ============================================
# OPTIONAL: GAS CONFIGURATION
# ============================================

# Max gas price in gwei (optional)
# MAX_GAS_PRICE=50

# Gas limit multiplier (optional, default 1.1)
# GAS_LIMIT_MULTIPLIER=1.2

# ============================================
# TESTING
# ============================================

# Use these for local testing with Anvil/Hardhat
# TEST_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# TEST_RPC_URL=http://127.0.0.1:8545
